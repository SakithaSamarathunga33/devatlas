{"nodes": [{"id": "docs_security_security_model", "label": "Security Model", "file_type": "document", "source_file": "docs/security/security-model.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_webview_rust_boundary", "label": "Webview / Rust Privilege Boundary", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The UI is untrusted-by-default web content in a webview; all privileged operations stay in Rust, and the security model is about keeping that boundary narrow."}, {"id": "docs_security_security_model_least_privilege_capabilities", "label": "Least-Privilege Capabilities", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main webview gets only its own app commands, scoped opener for http(s), event listen and four frameless-window permissions; no fs, shell or http plugins."}, {"id": "docs_security_security_model_command_allow_list", "label": "Explicit Command Allow-List (AppManifest::commands)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_strict_csp", "label": "Strict Content Security Policy", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts only from the app bundle; style-src allows unsafe-inline because UI libraries inject runtime styles."}, {"id": "docs_security_security_model_prototype_freezing", "label": "Prototype Freezing (freeze-prototype.js)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied to the app UI only; Tauri's global freezePrototype is off because freezing breaks many websites shown in the viewer."}, {"id": "docs_security_security_model_typed_validated_ipc", "label": "Typed, Zod-Validated IPC", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_no_unsafe_rust", "label": "No Unsafe Rust (unsafe_code = forbid)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_no_secrets_in_repository", "label": "No Secrets in Repository", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only CI secret is the release signing key held by the release environment; the Community key is Supabase's publishable key, public by design; the optional GitHub token lives in the OS credential store."}, {"id": "docs_security_security_model_saved_links", "label": "Saved Links (saved-links.json)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_read_only_browser_bookmarks", "label": "Read-Only Browser Bookmarks", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI picks a browser from a fixed list and a validated profile id so it can never name a path; Firefox places.sqlite is copied because Firefox locks the original; removal only hides in library-memory.json."}, {"id": "docs_security_security_model_bookmark_url_sanitization", "label": "Bookmark URL Sanitization", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_hardened_preview_fetching", "label": "Hardened Preview Fetching (SSRF Protection)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every DNS answer and redirect must be a public address (private, CGNAT, NAT64, 6to4, mapped IPv4 etc. refused), capped redirects, timeouts and size so a page cannot make the app request the local network."}, {"id": "docs_security_security_model_allow_listed_news_sources", "label": "Allow-Listed News Sources (NEWS_SOURCES)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_fixed_host_github_api", "label": "Fixed-Host GitHub API Client", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only fixed api.github.com paths, validated language filter and owner/name segments so input cannot add search qualifiers or reach another API path; token never returned to the UI."}, {"id": "docs_security_security_model_local_sqlite_database", "label": "Local SQLite Database (bound queries)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_native_dialogs_from_rust", "label": "Native Dialogs from Rust Only", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backups and imports are chosen in dialogs opened by Rust so the webview never supplies a path; imports are treated as untrusted."}, {"id": "docs_security_security_model_link_checks", "label": "Link Health Checks", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_isolated_site_viewer", "label": "Isolated In-App Site Viewer", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sites open in a separate native webview with no IPC access because the capability is bound to the main webview only."}, {"id": "docs_security_security_model_mcp_agent_access", "label": "MCP Agent Access (narrow read, narrower write)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stdio-only server, read tools open the DB read-only; update_resource is off until the user enables agent writes, because page titles could steer an agent into writing; untrusted text is stripped of invisible characters."}, {"id": "docs_security_security_model_agent_writes_setting", "label": "Let Agents Edit Notes and Tags (agent-writes.json)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_get_project_stack_confinement", "label": "get_project_stack Path Confinement", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads only five manifest files inside the agent's folder, never via symlink, and refuses network/device/verbatim paths since probing \\\\host\\share on Windows sends the user's credentials."}, {"id": "docs_security_security_model_github_stars_import", "label": "GitHub Stars Import and Sync", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_signed_self_update", "label": "Signed Self-Update (minisign)", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Package installs only if its minisign signature verifies against the built-in public key and the signed trusted comment names the exact file, so an older signed package cannot be re-served as newer; signing key usable only from main."}, {"id": "docs_security_security_model_community_supabase", "label": "Community (Supabase, RLS, GitHub OAuth PKCE)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App holds only the publishable key; row level security and checked functions decide access; others' links are never fetched so opening a collection tells owners nothing."}, {"id": "docs_security_security_model_collection_link_images", "label": "Collection Link Images (collection-covers bucket)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner's app re-encodes preview images as 480x270 JPEGs and uploads them so viewers never contact others' link sites; known limit: orphaned folders if a modified client deletes rows directly."}, {"id": "docs_security_security_model_agent_setups", "label": "Agent Setups Sharing", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only name, description and public source are kept; install commands are built by the app from ASCII-word names so a shared setup cannot carry shell text."}, {"id": "docs_security_security_model_library_sync", "label": "End-to-End Encrypted Library Sync", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Passphrase never stored or sent; Argon2id key, XChaCha20-Poly1305 seal with associated data binding account, generation and revision to prevent cross-account or replay; three-way merge with pre-sync backup."}, {"id": "docs_security_security_model_single_instance", "label": "Single Instance Plugin", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_bounded_log_file", "label": "Bounded Log File", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_security_model_future_feature_requirements", "label": "Security Requirements for Future Features", "file_type": "rationale", "source_file": "docs/security/security-model.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding requirements: per-window minimal permissions, Rust-side IPC validation, app-data-only filesystem, AI consent and credential-store keys, authenticated local-only extension channel, frozen lockfiles."}, {"id": "docs_security_security_model_browser_extension_channel", "label": "Browser Extension Channel (paired secret)", "file_type": "concept", "source_file": "docs/security/security-model.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_security_security_model", "target": "docs_security_security_model_webview_rust_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/security/security-model.md", "source_location": "L3", "weight": 1.0}, {"source": "docs_security_security_model_least_privilege_capabilities", "target": "docs_security_security_model_webview_rust_boundary", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/security/security-model.md", "source_location": "L10", "weight": 1.0}, {"source": "docs_security_security_model_command_allow_list", "target": "docs_security_security_model_least_privilege_capabilities", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/security/security-model.md", "source_location": "L11", "weight": 1.0}, {"source": "docs_security_security_model_prototype_freezing", "target": "docs_security_security_model_isolated_site_viewer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/security/security-model.md", "source_location": "L13", "weight": 1.0}, {"source": "docs_security_security_model_prototype_freezing", "target": "docs_security_security_model_typed_validated_ipc", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file"