{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the app's own UI webview only. Sites shown in the in-app viewer webview get no IPC access.",
  "webviews": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-library",
    "allow-mark-resource-opened",
    "allow-add-link",
    "allow-remove-link",
    "allow-get-resource-preview",
    "allow-list-trending-repos",
    "allow-get-github-repo",
    "allow-get-repo-activity",
    "allow-update-resource",
    "allow-list-groups",
    "allow-create-group",
    "allow-update-group",
    "allow-delete-group",
    "allow-set-group-resources",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-github-token",
    "allow-clear-github-token",
    "allow-list-snippets",
    "allow-create-snippet",
    "allow-update-snippet",
    "allow-delete-snippet",
    "allow-get-agent-connection",
    "allow-import-github-stars",
    "allow-list-removed-suggestions",
    "allow-remove-suggestion",
    "allow-restore-suggestions",
    "allow-export-backup",
    "allow-import-file",
    "allow-check-links",
    "allow-list-news",
    "allow-list-top-stories",
    "allow-list-language-rankings",
    "allow-get-star-boards",
    "allow-viewer-open",
    "allow-viewer-set-bounds",
    "allow-viewer-close",
    "allow-viewer-go",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
