{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the app's own UI webview only. Sites shown in the in-app viewer webview get no IPC access.",
  "webviews": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-library",
    "allow-mark-resource-opened",
    "allow-add-link",
    "allow-remove-link",
    "allow-get-resource-preview",
    "allow-list-trending-repos",
    "allow-get-github-repo",
    "allow-list-news",
    "allow-list-top-stories",
    "allow-list-language-rankings",
    "allow-get-star-boards",
    "allow-viewer-open",
    "allow-viewer-set-bounds",
    "allow-viewer-close",
    "allow-viewer-go",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
